# Make the per-user package library visible alongside the system library.
# The machine-level R_LIBS/R_LIBS_USER env vars point only at
# C:/Program Files/R/R-4.4.3/library, which is not writable without admin
# rights; packages the book needs (CLVTools, BTYD, tuneR, ...) are installed
# in the per-user library below.
R_LIBS=C:/Users/miken/AppData/Local/R/win-library/4.4;C:/Program Files/R/R-4.4.3/library
R_LIBS_USER=C:/Users/miken/AppData/Local/R/win-library/4.4
