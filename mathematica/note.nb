Cell[TextData[{
 "\n\n\n\[Beta] = weight of externalities \nThe weight is the same for a \
product category because it's market driven. If you want to assume it's \
firm-driven, it could be more challenging to support \n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    SubscriptBox["n", "A"], "=", " ", "xN"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    SubscriptBox["n", "B"], "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], "N"}]}], TraditionalForm]}],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfc5b816-c642-4f13-a514-0b7da7e5c931"],
 "\nWe assume that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", "=", " ", 
    RowBox[{"1", "-", "a"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75dda197-9390-4a01-8ea9-111d897c0bdc"],
 " which means the two firms' positions are symmetrical. \n\n"
}], "Text",
 CellChangeTimes->{{3.839622518491048*^9, 3.839622680123401*^9}, {
   3.8396227313866653`*^9, 3.839622759841219*^9}, 3.8396228008514533`*^9, {
