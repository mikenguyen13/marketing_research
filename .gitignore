# bookdown / knitr build artifacts
# NOTE: _book/ is intentionally NOT ignored â€” Posit Connect Cloud serves
# _book/index.html as a Static Document, so the rendered output must be committed.
_bookdown_files/
/*_files/
/*_cache/
*.knit.md
*.utf8.md
/*.md
!README.md
render*.rds
/Marketing Research.rds
/Marketing Research.tex
/Marketing Research.log
/Marketing-Research.tex
/Marketing-Research.log

# Quarto
/.quarto/

# Large raw analysis data â€” loaded locally; results are cached in _freeze/ after the
# first render, so the heavy .rds inputs don't need to live in git.
/data/capability/
/data/totalq.rds

# Stray single-file render outputs â€” the book builds into _book/, not the repo root.
/*.html
/*.rmarkdown
/site_libs/

# Weekly journal scan: raw Crossref dumps are regenerable, so they stay out of git.
# The scanner, the seen-DOI ledger, and the reviewed digests are tracked â€” the
# ledger in particular must persist, or every week re-surfaces the same papers.
.editorial/weekly/candidates-*.tsv
.editorial/weekly/candidates-*.md

# publisher PDFs (copyrighted; local reference only)
replication/claim-business-page/paper/
replication/criminal-deception/*.pdf
# KPSS replication: public data (large), NBER PDFs and their text dumps stay local
replication/kpss/*.csv
replication/kpss/*.zip
replication/kpss/*.pdf
replication/kpss/*.txt
replication/kpss/*.rds

# Donati et al. malaria replication: World Bank package stays local
replication/facebook-malaria/RR_IND_2024_180/
replication/facebook-malaria/*.zip

# Griffin-Kruger-Mahajan fraud-contagion kit (Harvard Dataverse, 374 MB) stays local
replication/fraud-contagion/kit/

# Boustanifar & Verriest (Mgmt Sci 2026) replication package: INFORMS terms forbid redistribution, stays local
replication/intangible-liabilities/package/

# Babina et al. (2024 JFE) Mendeley kit files, re-downloaded by replicate.R
replication/babina-ai-growth/kit/
